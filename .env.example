# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored -- never commit real secrets.

# Supabase project URL + anon key (Settings -> API in the Supabase dashboard).
# Both are safe to expose to the browser (NEXT_PUBLIC_) -- the anon key is
# meant to be public; real access control happens via Postgres RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Travelpayouts/Aviasales Data API token, for live flight prices
# (src/app/api/flights/price). Server-only -- never prefix with
# NEXT_PUBLIC_, this must never reach the browser bundle.
TRAVELPAYOUTS_API_TOKEN=

# Supabase SERVICE ROLE key (Settings -> API -> Project API keys -> service_role).
#
# !! THIS ONE IS DIFFERENT FROM EVERY OTHER KEY IN THIS FILE. !!
# It BYPASSES ROW LEVEL SECURITY COMPLETELY. Anyone who has it can read,
# change, or delete every row in every table -- including every user's email
# address -- regardless of any policy you have written. It is a database
# password. Treat a leak as a full database compromise: rotate it immediately
# in the Supabase dashboard.
#
#   * NEVER prefix it NEXT_PUBLIC_. Next.js inlines NEXT_PUBLIC_* variables
#     into the browser bundle as literal strings -- that would publish it to
#     every visitor on the next deploy.
#   * NEVER import src/lib/supabase/service.ts from a client component.
#   * Set it in Vercel as a plain (non-public) environment variable.
#
# Used only by the two server-side price-cache routes (src/app/api/flights/price,
# src/app/api/hotels/price) to write the shared cache tables, whose upsert RPCs
# are revoked from anon/authenticated in
# supabase/migrations/0010_revoke_anon_cache_writes.sql.
SUPABASE_SERVICE_ROLE_KEY=

# Unsplash Access Key, used ONLY by the build-time photo-fetch script
# (scripts/fetch-photos.mjs, run locally via `npm run fetch-photos`).
# Never used at runtime by the deployed app, and never prefixed
# NEXT_PUBLIC_ -- it does not need to exist in Vercel's environment at all,
# only wherever the fetch script is actually run.
UNSPLASH_ACCESS_KEY=
