# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored -- never commit real secrets.

# Supabase project URL + anon key (Settings -> API in the Supabase dashboard).
# Both are safe to expose to the browser (NEXT_PUBLIC_) -- the anon key is
# meant to be public; real access control happens via Postgres RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Travelpayouts/Aviasales Data API token, for live flight prices
# (src/app/api/flights/price). Server-only -- never prefix with
# NEXT_PUBLIC_, this must never reach the browser bundle.
TRAVELPAYOUTS_API_TOKEN=

# Unsplash Access Key, used ONLY by the build-time photo-fetch script
# (scripts/fetch-photos.mjs, run locally via `npm run fetch-photos`).
# Never used at runtime by the deployed app, and never prefixed
# NEXT_PUBLIC_ -- it does not need to exist in Vercel's environment at all,
# only wherever the fetch script is actually run.
UNSPLASH_ACCESS_KEY=
